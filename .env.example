# Server-side only — the real backend origin, WITHOUT a trailing slash and
# WITHOUT "/api" (e.g. https://barukerja-api.onrender.com). The browser
# calls "/api/..." on this same site; next.config.ts's rewrites forward
# that to "${BACKEND_API_URL}/api/...". See lib/api.ts's API_BASE comment.
BACKEND_API_URL=
